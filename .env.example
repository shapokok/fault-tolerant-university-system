# Copy to .env and put a new random value in every line, for example:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# .env is listed in .gitignore and must never be committed.
# Only the endterm stack (docker-compose.ft.yml) uses these values.

# Database owner: creates the schema, runs backups and admin scripts.
POSTGRES_PASSWORD=change-me
# uni_app: the least-privilege role the services use.
APP_DB_PASSWORD=change-me
# Streaming replication between primary and replica.
REPLICATOR_PASSWORD=change-me
# Signs the login tokens (HS256). At least 32 characters.
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-characters
# Synthetic accounts: student1..student50 share this password, plus one admin.
STUDENT_PASSWORD=change-me
ADMIN_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
